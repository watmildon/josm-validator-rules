/* Directional prefixes written with a trailing period, ex: "N. Main Street".

   The single letter forms are guarded with a negative lookahead so that a
   following initial is left alone. Names like "W. T. Montgomery Road" and
   "E. C. Reems Court" are personal initials, not directionals, and must not
   be expanded to "West T. Montgomery Road". */

*["name"=~/^N\. (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=North Main";
assertNoMatch: "way \"name\"=N. K. Chase";
assertMatch: "way \"name\"=N. Main";
throwWarning: tr("Highway name prefix N., may need to be expanded to North");
fixAdd: concat("name=", "North", substring(tag("name"), 2,length(tag("name"))));
}

*["name"=~/^S\. (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=South Main";
assertNoMatch: "way \"name\"=S. L. Davis Avenue";
assertMatch: "way \"name\"=S. Main";
throwWarning: tr("Highway name prefix S., may need to be expanded to South");
fixAdd: concat("name=", "South", substring(tag("name"), 2,length(tag("name"))));
}

*["name"=~/^E\. (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=East Main";
assertNoMatch: "way \"name\"=E. C. Reems Court";
assertMatch: "way \"name\"=E. Main";
throwWarning: tr("Highway name prefix E., may need to be expanded to East");
fixAdd: concat("name=", "East", substring(tag("name"), 2,length(tag("name"))));
}

*["name"=~/^W\. (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=West Main";
assertNoMatch: "way \"name\"=W. T. Montgomery Road";
assertMatch: "way \"name\"=W. Main";
throwWarning: tr("Highway name prefix W., may need to be expanded to West");
fixAdd: concat("name=", "West", substring(tag("name"), 2,length(tag("name"))));
}

*["addr:street"]["addr:street"=~/^N\. (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/] {
assertNoMatch: "way \"addr:street\"=North Main";
assertNoMatch: "way \"addr:street\"=N. K. Chase";
assertMatch: "way \"addr:street\"=N. Main";
throwWarning: tr("addr:street={0}, may need to be expanded to North","{0.value}");
fixAdd: concat("addr:street=", "North", substring(tag("addr:street"), 2,length(tag("addr:street"))));
group: tr("addr:street prefix N., may need to be expanded to North");
}

