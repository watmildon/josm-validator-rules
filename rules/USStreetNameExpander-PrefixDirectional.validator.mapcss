/* Lowercase directional prefixes, with or without a trailing period.

   One rule per direction covers both "n main st" and "n. 3rd": the fix uses
   regexp_match so it does not depend on whether the period is there. Expanding
   the directional does not fix the rest of the casing -- "w george richey rd"
   becomes "West george richey rd" -- but each rule fixes one thing. */
*["name"=~/^n\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=North Main";
assertMatch: "way \"name\"=n main st";
assertMatch: "way \"name\"=n. 3rd";
throwWarning: tr("Highway name prefix n, may need to be expanded to North");
fixAdd: concat("name=", "North", get(regexp_match("^n\\.?(.*)", tag("name")), 1));
}
*["name"=~/^s\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=South Main";
assertMatch: "way \"name\"=s broad st";
assertMatch: "way \"name\"=s. 27th street";
throwWarning: tr("Highway name prefix s, may need to be expanded to South");
fixAdd: concat("name=", "South", get(regexp_match("^s\\.?(.*)", tag("name")), 1));
}
*["name"=~/^e\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=East Main";
assertMatch: "way \"name\"=e front st";
assertMatch: "way \"name\"=e. 21st street";
throwWarning: tr("Highway name prefix e, may need to be expanded to East");
fixAdd: concat("name=", "East", get(regexp_match("^e\\.?(.*)", tag("name")), 1));
}
*["name"=~/^w\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=West Main";
assertMatch: "way \"name\"=w 12th Street";
assertMatch: "way \"name\"=w. mile 3 rd";
throwWarning: tr("Highway name prefix w, may need to be expanded to West");
fixAdd: concat("name=", "West", get(regexp_match("^w\\.?(.*)", tag("name")), 1));
}
*["name"=~/^ne\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=Northeast Main";
assertMatch: "way \"name\"=ne glisan st";
assertMatch: "way \"name\"=ne. glisan st";
throwWarning: tr("Highway name prefix ne, may need to be expanded to Northeast");
fixAdd: concat("name=", "Northeast", get(regexp_match("^ne\\.?(.*)", tag("name")), 1));
}
*["name"=~/^nw\.? (?![A-Za-z]\.)(?![Ss]t\.? )(?![Ss]treet\b)/].highway_name {
assertNoMatch: "way \"name\"=Northwest Main";
assertMatch: "way \"name\"=nw 84th terrace";
assertMatch: "way \"name\"=nw. 84th terrace";
throwWarning: tr("Highway name prefix nw, may need to be expanded to Northwest");
