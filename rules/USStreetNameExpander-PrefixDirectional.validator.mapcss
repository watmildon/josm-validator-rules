assertMatch: "way \"addr:street\"=Se. Main";
throwWarning: tr("addr:street={0}, may need to be expanded to Southeast","{0.value}");
fixAdd: concat("addr:street=", "Southeast", substring(tag("addr:street"), 3,length(tag("addr:street"))));
