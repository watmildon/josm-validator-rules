/* "So." spelled with a period is reliably South. Bare "So" is NOT: the data holds
   "So Long", "So Inclined", "So Big Road" and "So Hi Drive", so it is left alone.
   "No." is left alone too -- every US example is a number, ex: "No. 2 Side Road". */

*["name"=~/^So\. /].highway_name {
assertNoMatch: "way \"name\"=\"So Long\"";
assertMatch: "way \"name\"=\"So. 6th Street\"";
throwWarning: tr("Highway name prefix So., may need to be expanded to South");
fixAdd: concat("name=", "South", get(regexp_match("^So\\.(.*)", tag("name")), 1));
}

*["addr:street"]["addr:street"=~/^So\. /] {
assertNoMatch: "way \"addr:street\"=\"So Long\"";
assertMatch: "way \"addr:street\"=\"So. 6th Street\"";
throwWarning: tr("addr:street={0}, may need to be expanded to South","{0.value}");
fixAdd: concat("addr:street=", "South", get(regexp_match("^So\\.(.*)", tag("addr:street")), 1));
group: tr("addr:street prefix So., may need to be expanded to South");
}
